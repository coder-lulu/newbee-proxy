          }
        }
      ]
    },
    {
      "name": "Admin (state/reload)",
      "description": "Planned admin endpoints. If implemented, they control online/draining/offline and hot-reload.",
      "item": [
        {
          "name": "Get State (planned)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-PSK",
                "value": "{{psk}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/state"
          }
        },
        {
          "name": "Set State (planned)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-PSK",
                "value": "{{psk}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"draining\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/state"
          }
        },
        {
          "name": "Reload Config (planned)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-PSK",
                "value": "{{psk}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/reload"
          }
        }
      ]
    }
  ],
